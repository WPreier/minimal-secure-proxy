[Unit]
Description=Minimal Secure Proxy
After=network.target

[Service]
Type=notify
ExecStart=/usr/local/bin/msp --config /etc/msp/config.toml
# User= and Group= after privilege drop considerations
# AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
WatchdogSec=30

# Hardening examples
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
